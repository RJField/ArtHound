# Airtable credentials
# Get your personal access token at: https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=pat_your_token_here

# Found in your base URL: https://airtable.com/YOUR_BASE_ID/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Optional: override table names if they differ from the defaults shown
# TABLE_ASSETS=Assets
# TABLE_PRODUCTS=Product
# TABLE_TASKS=Tasking
# TABLE_TEMPLATES=Task Templates
# TABLE_ITEM_TYPES=Item Types
# TABLE_REVIEWS=Asset Reviews

PORT=3000

# Public base URL of this server — used to build screenshot attachment URLs for Airtable
# Must be reachable by Airtable's servers when reviews are submitted from Maya
# SERVER_URL=https://your-domain.example.com

# ── Anthropic (NumberBot) ──
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Supabase Auth ──
# Project URL and anon key: Project Settings → Configuration → Data API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key: Project Settings → Configuration → Data API
# Used server-side only (sync engine, DB writes). Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# JWT secret: Project Settings → Configuration → Data API → JWT Settings
# Never expose this value to the frontend or commit it to source control
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ── Sync triggers ──
# Shared secret for incoming webhook calls (Airtable → ArtHound).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure your Airtable webhook URL as:
#   POST https://your-domain/api/sync/webhook/airtable/studio/{studio_id}?secret=<this-value>
WEBHOOK_SECRET=your_webhook_secret_here

# Polling interval in seconds. 0 or unset = disabled.
# 300 = poll every 5 minutes. Recommended range: 60–900.
# SYNC_POLL_INTERVAL_SECONDS=300

# When true, webhook payloads are inspected for destroyedRecordIds and matching
# rows are deleted from replicated_assets, replicated_products, replicated_item_types.
# Verify the Airtable webhook payload shape against your base before enabling.
# ENABLE_WEBHOOK_DELETIONS=false
