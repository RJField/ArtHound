# Airtable credentials
# Get your personal access token at: https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=pat_your_token_here

# Found in your base URL: https://airtable.com/YOUR_BASE_ID/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Optional: override table names if they differ from the defaults shown
# TABLE_ASSETS=Assets
# TABLE_PRODUCTS=Product
# TABLE_TASKS=Tasking
# TABLE_TEMPLATES=Task Templates
# TABLE_ITEM_TYPES=Item Types

PORT=3000

# ── Anthropic (NumberBot) ──
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Supabase Auth ──
# Project URL and anon key: Project Settings → Configuration → Data API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key: Project Settings → Configuration → Data API
# Used server-side only (sync engine, DB writes). Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# JWT secret: Project Settings → Configuration → Data API → JWT Settings
# Never expose this value to the frontend or commit it to source control
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Signer for the arthound_system background-job token (RLS hardening #1, plan §0a).
# Generate: supabase gen signing-key --algorithm ES256 -o json  (compact it to one line)
# Then import the SAME key into the project as a STANDBY JWT signing key:
#   Project Settings → JWT Keys → add standby key → import the private JWK.
# The app signs system tokens with it (ES256); Supabase verifies via JWKS but never signs
# user tokens with it (standby). Leave unset to use the legacy HS256-over-SUPABASE_JWT_SECRET
# signer instead (rollback). Value is the private JWK on a single line, single-quoted.
# ARTHOUND_SYSTEM_SIGNING_JWK='{"kty":"EC","kid":"...","use":"sig","alg":"ES256","crv":"P-256","d":"...","x":"...","y":"..."}'

# ── Sync triggers ──
# Shared secret for incoming webhook calls (Airtable → ArtHound).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure your Airtable webhook URL as:
#   POST https://your-domain/api/sync/webhook/airtable/studio/{studio_id}?secret=<this-value>
WEBHOOK_SECRET=your_webhook_secret_here

# Polling interval in seconds. 0 or unset = disabled.
# 300 = poll every 5 minutes. Recommended range: 60–900.
# SYNC_POLL_INTERVAL_SECONDS=300

# When true, webhook payloads are inspected for destroyedRecordIds and matching
# rows are deleted from replicated_assets, replicated_products, replicated_item_types.
# Verify the Airtable webhook payload shape against your base before enabling.
# ENABLE_WEBHOOK_DELETIONS=false

# ── Jira connector ──
# Register ArtHound once in the Atlassian Developer Console to get these values.
# All studios share these credentials; per-studio tokens are stored in source_credentials.
# Scopes required: read:jira-work read:jira-user manage:jira-webhook offline_access
# Redirect URI must be registered in the Atlassian app: /api/connectors/jira/oauth/callback
JIRA_CLOUD_CLIENT_ID=your_atlassian_client_id
JIRA_CLOUD_CLIENT_SECRET=your_atlassian_client_secret
JIRA_REDIRECT_URI=https://your-domain/api/connectors/jira/oauth/callback

# Data Center: no global registration needed — each studio provides their own
# Application Link credentials during the init wizard.

# Where the OAuth callback redirects the user back to (the React app)
FRONTEND_URL=https://your-domain

# Nightly full-reconciliation interval in hours (0 = disabled). Default 24.
# FULL_SYNC_INTERVAL_HOURS=24
